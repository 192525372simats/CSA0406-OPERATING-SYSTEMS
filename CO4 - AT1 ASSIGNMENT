  #include <stdio.h>
  #include <stdlib.h>
  int main() {
  int request[10], n, head, i;
  int fcfs = 0, sstf = 0, current;
  printf("Enter number of requests: ");
  scanf("%d", &n);
  printf("Enter requests: ");
  for (i = 0; i < n; i++)
  scanf("%d", &request[i]);
  printf("Enter initial head: ");
  scanf("%d", &head);
  current = head;
  printf("\nFCFS Sequence: %d", head);
  for (i = 0; i < n; i++) {
  fcfs += abs(current - request[i]);
  current = request[i];
  printf(" -> %d", current);
    }
  printf("\nFCFS Seek Time = %d\n", fcfs);
  current = head;
  printf("\nSSTF Sequence: %d", head);
  for (i = 0; i < n; i++) {
  int min = 999, pos = -1, j;
  for (j = 0; j < n; j++) {
  if (request[j] >= 0) {
  int d = abs(current - request[j]);
  if (d < min) {
  min = d;
  pos = j;
  }
  }
  }
 sstf += min;
 current = request[pos];
 printf(" -> %d", current);
 request[pos] = -1;
 }
 printf("\nSSTF Seek Time = %d\n", sstf);
 printf("\nBest Algorithm: SSTF\n");
  return 0;
 }
