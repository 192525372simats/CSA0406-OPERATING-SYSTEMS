#include <stdio.h>
int main() {
int bt[3]={5,4,3};
int tq=2;
int i;
printf("Round Robin Execution\n");
while(bt[0]>0 || bt[1]>0 || bt[2]>0){
for(i=0;i<3;i++){
if(bt[i]>0){
if(bt[i]>tq){
printf("P%d -> %d units\n",i+1,tq);
bt[i]-=tq;
}else{
printf("P%d -> %d units (Completed)\n",i+1,bt[i]);
bt[i]=0;
}
}
}
}
return 0;
}
output:
Round Robin Execution
P1 -> 2 units
P2 -> 2 units
P3 -> 2 units
P1 -> 2 units
P2 -> 2 units (Completed)
P3 -> 1 units (Completed)
P1 -> 1 units (Completed) 
