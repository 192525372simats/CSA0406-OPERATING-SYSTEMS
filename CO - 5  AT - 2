                                     QUESTION 1
PSEUDOCODE:
BEGIN
SET threshold = 80%
usage = GET_DISK_USAGE()
IF usage > threshold THEN
DISPLAY "Disk usage exceeds 80%"
IDENTIFY all log_files
SORT log_files BY size DESCENDING
FOR each file IN log_files DO
IF file is old THEN
DELETE file
ELSE
COMPRESS or ROTATE file
ENDIF
usage = GET_DISK_USAGE()
IF usage <= threshold THEN
BREAK
ENDIF
ENDFOR
ELSE
DISPLAY "Disk usage is within safe limit"
ENDIF
END
                                                 QUESTION 2
PSEUDOCODE:
BEGIN
INPUT process_list
SORT process_list BY priority (highest first)
WHILE process_list is NOT EMPTY DO
SELECT process WITH highest priority
ALLOCATE CPU time
EXECUTE process
IF process is completed THEN
REMOVE process from process_list
ELSE
REDUCE priority slightly
ADD process back to process_list
ENDIF
SORT process_list BY priority (highest first)
ENDWHILE
END
